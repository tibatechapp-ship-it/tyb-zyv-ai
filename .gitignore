# ─── Secrets (NEVER commit) ────────────────────────────────────────────────
.env
*.env
telegram.env
secrets.*
*.pem
*.key
# zyvo runtime state / credentials
.config/zyvo/telegram.env
.config/zyvo/*-session

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# ─── Tooling caches ────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Generated audio / media (voice notes, transcripts) ────────────────────
